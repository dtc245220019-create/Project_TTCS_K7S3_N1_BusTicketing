# Cấu hình Chatbot AI trên Frontend (Tùy chọn)
# Hệ thống mặc định tự động kết nối Backend SmartBus AI Assistant (Zero-Config).
# Nếu muốn gọi trực tiếp Google Gemini hoặc OpenAI từ trình duyệt, sao chép file này thành .env.local

# Nhà cung cấp: 'gemini' hoặc 'openai'
VITE_AI_PROVIDER=gemini

# Khóa API của Google AI Studio (Gemini) hoặc OpenAI
VITE_AI_API_KEY=

# Model AI (mặc định: gemini-2.5-flash hoặc gpt-4o-mini)
VITE_AI_MODEL=gemini-2.5-flash
